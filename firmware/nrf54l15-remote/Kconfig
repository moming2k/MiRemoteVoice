menu "MiRemoteVoice remote"

choice APP_AUDIO_SOURCE
	prompt "Audio source"
	default APP_AUDIO_SOURCE_TONE

config APP_AUDIO_SOURCE_TONE
	bool "1 kHz test tone"
	help
	  Stream a generated tone instead of the microphone. Useful for
	  checking the Bluetooth and ADPCM path on a board without a mic.

config APP_AUDIO_SOURCE_DMIC
	bool "PDM microphone (pdm20)"
	select AUDIO
	select AUDIO_DMIC

endchoice

config APP_MIC_GAIN_SHIFT
	int "Digital gain applied to microphone samples (left shift)"
	depends on APP_AUDIO_SOURCE_DMIC
	range 0 4
	default 0
	help
	  Note that mi-remote-bridge already amplifies remote audio by
	  +20 dB, so a loud microphone clips without any extra gain here.

config APP_ATVV_FRAME_SIZE
	int "ADPCM bytes per audio notification"
	range 20 244
	default 120
	help
	  Advertised to the host in the capabilities response. The actual
	  notification size is also limited by the negotiated ATT MTU.

config APP_AUDIO_TRANSFER_TIMEOUT_SECONDS
	int "Audio Transfer Timeout (s)"
	range 15 60
	default 20
	help
	  Voice over BLE spec: stop the stream if the host sends no MIC_EXTEND
	  for this long (recommended 15 s to 1 min). mi-remote-bridge sends
	  MIC_EXTEND every 4 s, Android TV every 5-10 s.

config APP_STREAM_MAX_SECONDS
	int "Maximum length of a single voice stream (s)"
	default 120
	help
	  Hard cap, e.g. for a stuck button while the host keeps extending.

config APP_ACTIVE_REMOTE_TIMEOUT_SECONDS
	int "Active Remote Timeout (s), 0 to disable"
	default 60
	help
	  Voice over BLE spec (privacy): a host MIC_OPEN is refused unless the
	  voice button was pressed within this time. Only affects hosts using
	  the On-request model; Hold-to-Talk always requires a press anyway.

config APP_BUTTON_DEBOUNCE_MS
	int "Voice button debounce time (ms)"
	default 15

config APP_AUDIO_THREAD_STACK_SIZE
	int "Audio thread stack size"
	default 2048

config APP_AUDIO_THREAD_PRIORITY
	int "Audio thread priority"
	default 5

menu "Power"

config APP_ADV_FAST_SECONDS
	int "Fast advertising after boot, disconnect or a press (s)"
	default 30

config APP_POWEROFF
	bool "Enter System OFF when idle and disconnected"
	default y
	select POWEROFF
	help
	  The voice button wakes the remote (it resets and reconnects, so the
	  waking press itself is not delivered).

config APP_POWEROFF_IDLE_SECONDS
	int "Disconnected time before System OFF (s)"
	depends on APP_POWEROFF
	default 300

endmenu

menu "Wake press"

config APP_WAKE_CAPTURE
	bool "Record and deliver the press that wakes the remote"
	default y
	help
	  If the voice button is still down when the firmware starts (it woke
	  from System OFF), record audio while reconnecting and deliver it
	  once the host is ready. See src/wake.h.

# The options below stay defined when APP_WAKE_CAPTURE is off so the code
# using them still compiles.

config APP_WAKE_BUFFER_MS
	int "Backlog length (ms)"
	range 500 5000
	default 2000
	help
	  Newest audio kept while reconnecting (8 bytes of RAM per ms).
	  mi-remote-bridge queues at most 2 s of audio, so more is not useful
	  with it.

config APP_WAKE_MIN_REPLAY_MS
	int "Minimum recording to replay a released wake press (ms)"
	default 400
	help
	  Shorter presses are treated as a tap that only wakes the remote.

config APP_WAKE_ROUTE_DELAY_MS
	int "Delay between AUDIO_START and sending the backlog (ms)"
	default 400
	help
	  mi-remote-bridge routes the remote microphone only after the key has
	  been held for 300 ms and drops audio received before that.

config APP_WAKE_TIMEOUT_SECONDS
	int "Give up if the host is not ready within (s)"
	default 10

endmenu

menu "Battery"

choice APP_BATTERY_CURVE
	prompt "Battery voltage to percentage mapping"
	default APP_BATTERY_CURVE_LINEAR

config APP_BATTERY_CURVE_LIPO
	bool "Single-cell LiPo (3.3-4.2 V)"

config APP_BATTERY_CURVE_LINEAR
	bool "Linear between APP_BATTERY_EMPTY_MV and APP_BATTERY_FULL_MV"

endchoice

config APP_BATTERY_EMPTY_MV
	int "Voltage reported as 0 %"
	depends on APP_BATTERY_CURVE_LINEAR
	default 2000

config APP_BATTERY_FULL_MV
	int "Voltage reported as 100 %"
	depends on APP_BATTERY_CURVE_LINEAR
	default 3000

config APP_BATTERY_INTERVAL_SECONDS
	int "Battery measurement interval (s)"
	default 600

endmenu

config APP_PRODUCTION_BUILD
	bool "Production build checks"
	help
	  Fail the build if the Device Information PnP VID/PID are still
	  Nordic's sample IDs.

module = APP
module-str = MiRemoteVoice remote
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
